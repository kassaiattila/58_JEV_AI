# TypeSafe (JAV) API kulcs - https://console.typesafe.ai/
# Másold .env néven, és töltsd ki. A .env git-ignorált.
TypeSafeJAV_API_KEY=ts-...

# OpenAI kulcs a G-kar generatív kivonatolásához (gpt-5.4-mini, Pydantic AI olvassa)
OPENAI_API_KEY=sk-...

# Opcionális: a régi AIFLOW V4 projekt helye (golden, régi adatok). Alapérték: C:\00_DEV_LOCAL\10_AIFLOW_V4
# JAV_LEGACY_ROOT=C:\00_DEV_LOCAL\10_AIFLOW_V4
# Plusz engedélyezett mappák a felülethez (;-vel elválasztva), lásd docs/guides/SETUP.md
# JAV_API_ROOTS="D:\Szamlak\Bejovo"
