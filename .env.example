# Copy this file to .env and fill it in. .env is git-ignored; never commit it.

# --- Required ---------------------------------------------------------------
# TypeSafe (JEV) API key - https://console.typesafe.ai/ (TYPESAFE_API_KEY is also accepted)
TypeSafeJAV_API_KEY=ts-...

# OpenAI key for the G path (GPT extraction with Pydantic AI, model in configs/models.json) and for task proposals
OPENAI_API_KEY=sk-...

# --- Optional ---------------------------------------------------------------
# Location of the legacy AIFLOW V4 project (golden sets, legacy data; read-only).
# Default: the 10_AIFLOW_V4 folder next to this repository.
# JAV_LEGACY_ROOT=D:\path\to\10_AIFLOW_V4

# Azure Document Intelligence for the paid escalation of weak local OCR, called directly (configs/ocr.json); without
# these the legacy sidecar is used, which reads only documents under the legacy project's data folder.
# AZURE_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_DI_KEY=

# Second location of the daily store backup, for example a network drive (default: none, local backup only).
# JAV_BACKUP_COPY_TO=\\server\share\jav-backup

# Extra folders the UI may open, separated by ";" (only used when configs/service.json has restrict_paths: true;
# see docs/guides/SETUP.md)
# JAV_API_ROOTS="D:\Invoices\Incoming"

# Bearer token for the standalone email receiver (email-ingest-server) used by the legacy outlook_bridge.ps1
# (-ApiToken); --token overrides it. Without either, the receiver generates a random token at start-up and prints it.
# JAV_INGEST_TOKEN=

# OCR engine override for measurements: native | docker | azure_di (azure_di is PAID and page-limited; the default,
# "auto", comes from configs/ocr.json and never picks Azure; OCR escalation in the same file still can)
# JAV_OCR_ENGINE=native

# Set to 1 only to allow the TypeSafe SDK debug log (it can contain request text; use on synthetic data only)
# JAV_ALLOW_SDK_DEBUG=1

# Deeper property-based testing (default 150 examples per test)
# JAV_HYPOTHESIS_EXAMPLES=3000
