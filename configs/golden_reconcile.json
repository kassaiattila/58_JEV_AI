{
  "meta": {
    "name": "golden_reconcile",
    "version": "1.1.0",
    "description": "128 F-reconciliation: invented golden cases for jav/reconcile.py (no real data). Each case is a snapshot (invoices, statements with their lines, optionally a person's decisions per invoice and line) and the expected proposal: the candidate pairs [line, invoice, proposed, multiple], the exclusions [kind, id, reason], every invoice's status and the confirmed pairs [line, invoice]. Expectation: every case exactly (DECISIONS 128).",
    "changelog": [
      {
        "version": "1.1.0",
        "date": "2026-10-08",
        "note": "129 K2: three cases for a person's decision - a rejected pair is not proposed again, a confirmed pair takes its line and invoice out of the other proposals, a decision on a line that is gone changes nothing."
      },
      {
        "version": "1.0.0",
        "date": "2026-10-08",
        "note": "128 K1: the legacy project's 12 synthetic cases (flows/payables-reconcile-bare/golden/manifest.json, 10_AIFLOW_V4 HEAD 4256cba) rewritten for the first version's rules (partial and combined payments are listed, not proposed; the owner-alias case became the outgoing invoice), and new cases for the window, the signals, the exclusions and the coverage."
      }
    ]
  },
  "defaults": {
    "invoice": {"doc_type": "invoice_hu", "amount": "100.00", "currency": "HUF", "supplier_name": "Example Supplier Kft.",
                "payment_account": "99998887-77776666-55554444", "issue_date": "2026-04-01", "due_date": "2026-04-15"},
    "statement": {"account": "11112223-33334444-55556666", "currency": "HUF", "statement_type": "bank_account",
                  "period_start": "2026-03-01", "period_end": "2026-06-30", "verified": true},
    "line": {"booking_date": "2026-04-10", "direction": "debit", "amount": "100.00", "counterparty_name": "Example Supplier",
             "counterparty_account": "99998887-77776666-55554444"}
  },
  "cases": [
    {"id": "one_payment", "note": "legacy one_payment: amount, account and name agree",
     "invoices": [{"id": "i1", "number": "INV-0001"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [["t1", "i1", true, false]], "excluded": [], "status": {"i1": "proposed"}}},
    {"id": "partial_payments", "note": "legacy partial_payments: two lines pay one invoice in part; listed, not proposed in the first version",
     "invoices": [{"id": "i1", "number": "INV-0001"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "amount": "40.00"}, {"id": "t2", "amount": "60.00", "booking_date": "2026-04-12"}]}],
     "expected": {"pairs": [["t1", "i1", false, false], ["t2", "i1", false, false]], "excluded": [], "status": {"i1": "amount_differs"}}},
    {"id": "combined_payment", "note": "legacy combined_payment: one line pays two invoices; listed, not proposed",
     "invoices": [{"id": "i1", "number": "INV-0001", "amount": "40.00"}, {"id": "i2", "number": "INV-0002", "amount": "60.00"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [["t1", "i1", false, false], ["t1", "i2", false, false]], "excluded": [],
                  "status": {"i1": "amount_differs", "i2": "amount_differs"}}},
    {"id": "ambiguous", "note": "legacy ambiguous: two equal invoices of one supplier, one line; both proposed and flagged",
     "invoices": [{"id": "i1", "number": "INV-0001"}, {"id": "i2", "number": "INV-0002"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [["t1", "i1", true, true], ["t1", "i2", true, true]], "excluded": [],
                  "status": {"i1": "proposed", "i2": "proposed"}}},
    {"id": "different_currency", "note": "legacy different_currency: no conversion; no EUR statement, so not covered",
     "invoices": [{"id": "i1", "number": "INV-0001", "currency": "EUR"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [], "excluded": [], "status": {"i1": "not_covered"}}},
    {"id": "own_transfer", "note": "legacy own_transfer: a line to another own account is a transfer",
     "invoices": [{"id": "i1", "number": "INV-0001"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "counterparty_account": "12121212-34343434-56565656"}]},
                    {"id": "s2", "account": "12121212-34343434-56565656", "lines": []}],
     "expected": {"pairs": [], "excluded": [["line", "t1", "own_account_transfer"]], "status": {"i1": "no_payment_found"}}},
    {"id": "outgoing_invoice", "note": "replaces legacy other_owner (no owner aliases here): an outgoing invoice is not paid from an own account",
     "invoices": [{"id": "i1", "number": "INV-0001", "doc_type": "invoice_out"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [], "excluded": [["invoice", "i1", "outgoing_invoice"]], "status": {"i1": "excluded"}}},
    {"id": "duplicate_invoice", "note": "legacy duplicate_invoice: the same supplier and number twice without a decision; both wait for the duplicate decision",
     "invoices": [{"id": "i1", "number": "INV-0001"}, {"id": "i2", "number": "INV 0001"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [], "excluded": [["invoice", "i1", "duplicate_undecided"], ["invoice", "i2", "duplicate_undecided"]],
                  "status": {"i1": "excluded", "i2": "excluded"}}},
    {"id": "negative_invoice", "note": "legacy negative_invoice: a credit note is not paid",
     "invoices": [{"id": "i1", "number": "INV-0001", "amount": "-100.00"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [], "excluded": [["invoice", "i1", "non_positive_amount"]], "status": {"i1": "excluded"}}},
    {"id": "amount_alone", "note": "legacy amount_alone: an equal amount without a signal ties nothing",
     "invoices": [{"id": "i1", "number": "INV-0001"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "counterparty_name": "Somebody Else", "counterparty_account": null}]}],
     "expected": {"pairs": [], "excluded": [], "status": {"i1": "no_payment_found"}}},
    {"id": "supplier_iban_domestic_equivalence", "note": "legacy: the supplier's IBAN on the invoice and its domestic number on the line are one account",
     "invoices": [{"id": "i1", "number": "INV-0001", "supplier_name": "Another Name Zrt.", "payment_account": "HU00 9999 8887 7777 6666 5555 4444"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "counterparty_name": null}]}],
     "expected": {"pairs": [["t1", "i1", true, false]], "excluded": [], "status": {"i1": "proposed"}}},
    {"id": "own_account_iban_domestic_equivalence", "note": "legacy: an own account printed as an IBAN on one statement and as a domestic number on a line is one account",
     "invoices": [{"id": "i1", "number": "INV-0001"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "counterparty_account": "12121212-34343434-56565656"}]},
                    {"id": "s2", "account": "HU00 1212 1212 3434 3434 5656 5656", "lines": []}],
     "expected": {"pairs": [], "excluded": [["line", "t1", "own_account_transfer"]], "status": {"i1": "no_payment_found"}}},
    {"id": "number_in_memo", "note": "the invoice number in the memo is enough as a signal",
     "invoices": [{"id": "i1", "number": "INV-0001", "supplier_name": "Unrelated Name Kft.", "payment_account": null}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "counterparty_name": "Somebody", "counterparty_account": null, "memo": "Payment of INV-0001"}]}],
     "expected": {"pairs": [["t1", "i1", true, false]], "excluded": [], "status": {"i1": "proposed"}}},
    {"id": "compact_number_in_memo", "note": "a number written without its separators still matches (six characters or more)",
     "invoices": [{"id": "i1", "number": "AB-2026/000123", "supplier_name": "Unrelated Name Kft.", "payment_account": null}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "counterparty_name": null, "counterparty_account": null, "memo": "szla AB2026000123"}]}],
     "expected": {"pairs": [["t1", "i1", true, false]], "excluded": [], "status": {"i1": "proposed"}}},
    {"id": "short_number_is_no_signal", "note": "a short number inside another number is no signal",
     "invoices": [{"id": "i1", "number": "12", "supplier_name": "Unrelated Name Kft.", "payment_account": null}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "counterparty_name": null, "counterparty_account": null, "memo": "order 4123"}]}],
     "expected": {"pairs": [], "excluded": [], "status": {"i1": "no_payment_found"}}},
    {"id": "outside_window", "note": "a payment long after the due date is outside the window",
     "invoices": [{"id": "i1", "number": "INV-0001", "issue_date": "2026-01-02", "due_date": "2026-01-10"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [], "excluded": [], "status": {"i1": "partly_covered"}}},
    {"id": "advance_payment", "note": "a payment up to 31 days before the issue date is in the window",
     "invoices": [{"id": "i1", "number": "INV-0001", "issue_date": "2026-05-05", "due_date": "2026-05-05"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "booking_date": "2026-04-20"}]}],
     "expected": {"pairs": [["t1", "i1", true, false]], "excluded": [], "status": {"i1": "proposed"}}},
    {"id": "incoming_and_fee_lines", "note": "an incoming line and a bank fee are excluded with their reasons",
     "invoices": [{"id": "i1", "number": "INV-0001"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1", "direction": "credit"},
                                          {"id": "t2", "counterparty_name": null, "counterparty_account": null, "description": "Számlavezetési díj"}]}],
     "expected": {"pairs": [], "excluded": [["line", "t1", "not_outgoing_payment"], ["line", "t2", "payment_kind_review"]],
                  "status": {"i1": "no_payment_found"}}},
    {"id": "partly_covered", "note": "verified statements cover only part of the window",
     "invoices": [{"id": "i1", "number": "INV-0001", "issue_date": "2026-04-20", "due_date": "2026-04-28"}],
     "statements": [{"id": "s1", "period_start": "2026-04-01", "period_end": "2026-04-30", "lines": []}],
     "expected": {"pairs": [], "excluded": [], "status": {"i1": "partly_covered"}}},
    {"id": "consecutive_statements_cover", "note": "two consecutive verified statements of one account cover the window together",
     "invoices": [{"id": "i1", "number": "INV-0001", "issue_date": "2026-05-10", "due_date": "2026-05-20"}],
     "statements": [{"id": "s1", "period_start": "2026-04-01", "period_end": "2026-05-31", "lines": []},
                    {"id": "s2", "period_start": "2026-06-01", "period_end": "2026-07-31", "lines": []}],
     "expected": {"pairs": [], "excluded": [], "status": {"i1": "no_payment_found"}}},
    {"id": "unverified_statement", "note": "an unverified statement is no coverage, and its pair needs a look at the source",
     "invoices": [{"id": "i1", "number": "INV-0001"}, {"id": "i2", "number": "INV-0002", "supplier_name": "Second Supplier Kft.", "payment_account": null}],
     "statements": [{"id": "s1", "verified": false, "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [["t1", "i1", true, false]], "excluded": [], "status": {"i1": "proposed", "i2": "not_covered"}},
     "source_review": ["t1"]},
    {"id": "second_account_uncovered", "note": "every own account of the currency must cover the window",
     "invoices": [{"id": "i1", "number": "INV-0001"}],
     "statements": [{"id": "s1", "lines": []},
                    {"id": "s2", "account": "12121212-34343434-56565656", "statement_type": "credit_card", "period_start": "2026-04-05", "period_end": "2026-05-04", "lines": []}],
     "expected": {"pairs": [], "excluded": [], "status": {"i1": "partly_covered"}}},
    {"id": "confirmed_copy", "note": "the repeat of a confirmed copy drops out; the original stays",
     "invoices": [{"id": "i1", "number": "INV-0001"}, {"id": "i2", "number": "INV-0001", "duplicate": "copy"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [["t1", "i1", true, false]], "excluded": [["invoice", "i2", "duplicate_copy"]],
                  "status": {"i1": "proposed", "i2": "excluded"}}},
    {"id": "decided_distinct", "note": "two invoices a person called different are both eligible",
     "invoices": [{"id": "i1", "number": "INV-0001", "duplicate": "distinct"},
                  {"id": "i2", "number": "INV-0001", "duplicate": "distinct", "amount": "250.00"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "expected": {"pairs": [["t1", "i1", true, false], ["t1", "i2", false, false]], "excluded": [],
                  "status": {"i1": "proposed", "i2": "amount_differs"}}},
    {"id": "decision_rejects_one_of_two", "note": "129: of two equal invoices a person rejects one; the other is no longer ambiguous",
     "invoices": [{"id": "i1", "number": "INV-0001"}, {"id": "i2", "number": "INV-0002"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "decisions": [{"invoice_id": "i1", "line_id": "t1", "decision": "not_this"}],
     "expected": {"pairs": [["t1", "i2", true, false]], "excluded": [], "status": {"i1": "no_payment_found", "i2": "proposed"}}},
    {"id": "decision_confirms_pair", "note": "129: a confirmed pair takes the line out of the other invoice's proposal",
     "invoices": [{"id": "i1", "number": "INV-0001"}, {"id": "i2", "number": "INV-0002"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "decisions": [{"invoice_id": "i2", "line_id": "t1", "decision": "paid_by"}],
     "expected": {"pairs": [], "excluded": [], "status": {"i1": "no_payment_found", "i2": "confirmed"}, "confirmed": [["t1", "i2"]]}},
    {"id": "decision_on_a_missing_line", "note": "129: decisions on lines a re-extraction removed change nothing",
     "invoices": [{"id": "i1", "number": "INV-0001"}],
     "statements": [{"id": "s1", "lines": [{"id": "t1"}]}],
     "decisions": [{"invoice_id": "i1", "line_id": "t9", "decision": "paid_by"}, {"invoice_id": "i1", "line_id": "t8", "decision": "not_this"}],
     "expected": {"pairs": [["t1", "i1", true, false]], "excluded": [], "status": {"i1": "proposed"}}}
  ]
}
