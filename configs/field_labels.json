{
 "meta": {
  "name": "field_labels",
  "version": "1.17.0",
  "changelog": [
   {
    "version": "1.17.0",
    "date": "2026-10-29",
    "note": "231 (stage F, D4; the owner's decision of 2026-10-29: downloads and file names follow the interface's language): the names have English sources, as the interface's own texts; their Hungarian is in the interface's dictionary (ui/src/i18n/hu-native.json), which the service's downloads and file names use too (jav/core/display.py)."
   },
   {
    "version": "1.16.0",
    "date": "2026-10-28",
    "note": "231 (stage U, the walkthrough): a statement read by code is named by the bank's export, not a table export only (an XML statement is read so too)."
   },
   {
    "version": "1.15.0",
    "date": "2026-10-28",
    "note": "231 (stage U, U1; finding 7 of the walkthrough): the names of a field's enumerated values (`values`, keyed `field=value`): the kind of a bank statement, a document's and a meeting's kind, which the result table showed as codes."
   },
   {
    "version": "1.14.0",
    "date": "2026-10-28",
    "note": "231 (stage U, U1; the walkthrough of 2026-10-28): the name of a statement read by code from a bank's table export, which a result table showed as its code."
   },
   {
    "version": "1.13.0",
    "date": "2026-10-28",
    "note": "231 (stage U, U-A7): the Hungarian names of the quote request's and the property schedule's new protection fields."
   },
   {
    "version": "1.12.0",
    "date": "2026-10-27",
    "note": "231 (stage U, U-A6): the Hungarian names of the quote request's three new fields."
   },
   {
    "version": "1.11.0",
    "date": "2026-10-26",
    "note": "231 (stage D, D-e1): the Hungarian names of the insurance application packs' fields and list columns, and of their types."
   },
   {
    "version": "1.10.0",
    "date": "2026-10-22",
    "note": "199 (plan 197 K2d): the taught ticket (belepo_jegy_taught) is detected now; its name no longer says candidate."
   },
   {
    "version": "1.9.0",
    "date": "2026-10-22",
    "note": "197 (plan 197 K2b): the name of the taught ticket candidate (belepo_jegy_taught); its fields use the shared names."
   },
   {
    "version": "1.8.0",
    "date": "2026-10-22",
    "note": "197 (plan 197 K0): a type's own name for a shared field (`by_type`). The quote request's customer is the requester; the shared name of `customer_name` is again the utility bills' \"Felhasználó neve\", which 1.7.0 had overwritten for every type."
   },
   {
    "version": "1.7.0",
    "date": "2026-10-21",
    "note": "190 (plan 189 A2e): the Hungarian names of the quote request's fields and its type."
   },
   {
    "version": "1.6.0",
    "date": "2026-10-11",
    "note": "144 (DECISIONS 144): the Hungarian names of a statement line's facts beyond the money, read by code: the bank's reference, the order id, the parties' end-to-end id, the masked card number, the purchase day, the time, the terminal, the authorisation code, the exchange rate and the fee."
   },
   {
    "version": "1.5.0",
    "date": "2026-10-10",
    "note": "137 (DECISIONS 137): the Hungarian names of a statement line's two new columns, a card purchase's original amount and currency (the Erste PDF statement read by code)."
   },
   {
    "version": "1.4.0",
    "date": "2026-10-07",
    "note": "122 (backlog F-pro-forma): the Hungarian name of the new pro forma invoice type."
   },
   {
    "version": "1.3.0",
    "date": "2026-09-29",
    "note": "065: the Hungarian names of the recognition's broad categories (M1) too (egyéb irat, szerződés, nyugta, közműszámla…); an email's attachment used to show the machine name (for example ‘other’)"
   },
   {
    "version": "1.0.0",
    "date": "2026-09-28",
    "note": "056 U1: the Hungarian names of the fields and of the itemised list's columns in one place (moved from the interface's ui/src/labels.ts), so the service's search and sorting go by the Hungarian name too"
   },
   {
    "version": "1.1.0",
    "date": "2026-09-28",
    "note": "057: the Hungarian names of the 23 document types (doc_types), the interface's and the service's shared dictionary; the type packs had only an English description"
   },
   {
    "version": "1.2.0",
    "date": "2026-09-28",
    "note": "058: the 83 missing field names of the utility types and the legacy types (until now they showed their machine names) and the text list column's (*) name; a test keeps every type pack field named in Hungarian"
   }
  ]
 },
