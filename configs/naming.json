{
 "meta": {
  "name": "naming",
  "version": "1.9.0",
  "changelog": [
   {
    "version": "1.9.0",
    "date": "2026-10-29",
    "note": "231 (stage F, F3 D4; the owner's decision of 2026-10-29: the file names follow the interface's language): the type tokens, the placeholders, the review folder, the manifest's name and the reasons', columns' and statuses' labels are English sources; their Hungarian (the earlier words, unchanged) comes from the interface's dictionary (ui/src/i18n/hu-native.json), and a name is built in the requesting interface's language. The legal forms are document vocabulary and stay."
   },
   {
    "version": "1.8.0",
    "date": "2026-10-26",
    "note": "231 (stage D, D-e1): the insurance application (detection type insurance_application) and its three packs: the request form by the day cover starts and the policyholder, the property schedule by the policyholder and the site's number, the claims history by the end of its period and the policyholder."
   },
   {
    "version": "1.7.0",
    "date": "2026-10-22",
    "note": "197 (K2b): the taught ticket candidate (belepo_jegy_taught) is named as the ticket is."
   },
   {
    "version": "1.6.0",
    "date": "2026-10-21",
    "note": "190 (plan 189 A2e): the quote request (type pack and detection type quote_request): its deadline (the only date of the record, a filler when missing) and the customer; the reference is often missing, so it is not part of the name."
   },
   {
    "version": "1.5.0",
    "date": "2026-10-17",
    "note": "167 (review AI-7): the llm:truncated to-do (GPT's extraction cut off at its output cap, nothing extracted) is about the whole document, like llm:failed: its copy goes to the review folder."
   },
   {
    "version": "1.4.0",
    "date": "2026-10-10",
    "note": "136 E4: the token of a statement read from a bank's table export (KIVONAT_TABLA), named like the other bank statements."
   },
   {
    "version": "1.3.0",
    "date": "2026-10-07",
    "note": "122 (backlog F-pro-forma): the pro forma invoice's own token (DIJBEKERO), named like a Hungarian invoice."
   },
   {
    "version": "1.2.0",
    "date": "2026-10-06",
    "note": "120: the role-pair check (validator:parties.same_entity) replaces the S-path-only parties:same_* reasons and, like them, marks the name parts of the copy's name."
   },
   {
    "version": "1.1.0",
    "date": "2026-09-30",
    "note": "078 free trial on the local runs: the long legal forms of names are shortened (legal_forms), a part over the limit is cut at a word boundary, and the street part drops a leading postcode and town when there is no comma and has one letter case."
   },
   {
    "version": "1.0.0",
    "date": "2026-09-30",
    "note": "078 (owner decisions of 2026-09-30): content-based names for copies of the processed documents, date first, no accents; a copy whose name rests on an open to-do, a missing field or an unknown type goes to the review folder. Ported from the legacy outputnaming.py / ingest_folder.py rules and generalised per type."
   }
  ]
 },
 "separator": "_",
 "review_folder": "to-check",
 "manifest_file": "manifest.csv",
 "part_max_chars": 40,
 "stem_max_chars": 120,
 "path_max_chars": 250,
 "placeholders": {
  "date": "no-date",
  "value": "unknown",
  "type": "UNKNOWN"
 },
 "default_pattern": "{@date}_{@type}_{@original}",
 "legal_forms": {
  "Zártkörűen Működő Részvénytársaság": "Zrt",
  "Zártkörűen Működő Rt": "Zrt",
  "Nyilvánosan Működő Részvénytársaság": "Nyrt",
  "Nyilvánosan Működő Rt": "Nyrt",
  "Korlátolt Felelősségű Társaság": "Kft",
  "Betéti Társaság": "Bt",
  "Közkereseti Társaság": "Kkt",
  "Egyéni Vállalkozó": "ev",
  "Egyéni Cég": "ec",
  "Részvénytársaság": "Rt",
  "Nonprofit Korlátolt Felelősségű Társaság": "Nonprofit Kft",
  "Limited": "Ltd",
  "Incorporated": "Inc",
  "Corporation": "Corp",
  "Gesellschaft mit beschränkter Haftung": "GmbH"
 },
 "types": {
  "invoice_hu": {"token": "HU-INVOICE", "pattern": "{issue_date|fulfillment_date}_{@type}_{supplier_name}_{invoice_number}"},
  "invoice_foreign": {"token": "FOREIGN-INVOICE", "pattern": "{issue_date}_{@type}_{supplier_name}_{invoice_number}"},
  "invoice_out": {"token": "OUTGOING-INVOICE", "pattern": "{issue_date|fulfillment_date}_{@type}_{buyer_name}_{invoice_number}"},
  "proforma_invoice": {"token": "PROFORMA", "pattern": "{issue_date}_{@type}_{supplier_name}_{invoice_number}"},
  "villamos_energia_szamla": {"token": "ELECTRICITY", "pattern": "{billing_period_start|issue_date}_{@type}_{supplier_name}_{consumption_address:street}"},
  "foldgaz_szamla": {"token": "GAS", "pattern": "{billing_period_start|issue_date}_{@type}_{supplier_name}_{consumption_address:street}"},
  "viz_szamla": {"token": "WATER", "pattern": "{billing_period_start|issue_date}_{@type}_{supplier_name}_{consumption_address:street}"},
  "vizmuvek_szamla": {"token": "WATER", "pattern": "{billing_period_start|issue_date}_{@type}_{supplier_name}_{consumption_address:street}"},
  "csatorna_szamla": {"token": "SEWERAGE", "pattern": "{billing_period_start|issue_date}_{@type}_{supplier_name}_{consumption_address:street}"},
  "mohu_szamla": {"token": "WASTE", "pattern": "{billing_period_start|issue_date}_{@type}_{supplier_name}_{consumption_address:street}"},
  "statement_cib": {"token": "STATEMENT_CIB", "pattern": "{period_start}_{period_end}_{@type}_{currency}_{account_no|account_iban:last8}"},
  "statement_erste": {"token": "STATEMENT_ERSTE", "pattern": "{period_start}_{period_end}_{@type}_{currency}_{account_no|account_iban:last8}"},
  "statement_table": {"token": "STATEMENT_TABLE", "pattern": "{period_start}_{period_end}_{@type}_{currency}_{account_no|account_iban:last8}"},
  "nav_certificate": {"token": "NAV-CERTIFICATE", "pattern": "{issue_date}_{@type}_{taxpayer_name}_{tax_year}"},
  "nav_receipt": {"token": "NAV-ACKNOWLEDGEMENT", "pattern": "{issue_date}_{@type}_{taxpayer_name}_{reference_number}"},
  "nav_tax_return": {"token": "NAV-TAX-RETURN", "pattern": "{issue_date}_{@type}_{taxpayer_name}_{form_code}"},
  "certificate": {"token": "CERTIFICATE", "pattern": "{issue_date}_{@type}_{issuer}_{holder_name}"},
  "id_document": {"token": "ID-DOCUMENT", "pattern": "{valid_until}_{@type}_{holder_name}_{document_kind}"},
  "belepo_jegy": {"token": "ENTRY-TICKET", "pattern": "{event_datetime:date}_{@type}_{event_name}_{ticket_id}"},
  "belepo_jegy_taught": {"token": "ENTRY-TICKET", "pattern": "{event_datetime:date}_{@type}_{event_name}_{ticket_id}"},
  "meghivo": {"token": "INVITATION", "pattern": "{event_datetime:date}_{@type}_{organizer}_{event_name}"},
  "meeting_minutes": {"token": "MINUTES", "pattern": "{meeting_date}_{@type}_{organization_name}_{meeting_type}"},
  "csapatmenedzser_utasitas": {"token": "INSTRUCTION", "pattern": "{date}_{@type}_{issuing_body}_{subject}"},
  "altalanos_szerzodesi_feltetelek": {"token": "TERMS", "pattern": "{effective_date}_{@type}_{seller_name}_{document_title}"},
  "quote_request": {"token": "QUOTE-REQUEST", "pattern": "{@date}_{@type}_{customer_name}"},
  "insurance_application": {"token": "INSURANCE_APPLICATION"},
  "insurance_request": {"token": "INSURANCE_REQUEST", "pattern": "{cover_start}_{@type}_{policyholder_name}"},
  "property_schedule": {"token": "PROPERTY_SCHEDULE", "pattern": "{@type}_{policyholder_name}_{site_no}"},
  "claims_history": {"token": "CLAIMS_HISTORY", "pattern": "{period_end}_{@type}_{policyholder_name}"},
  "insurance_claim_form": {"token": "CLAIM_FORM", "pattern": "{@date}_{@type}_{insurer}_{policy_number|form_code}"},
  "terkep_adat": {"token": "MAP", "pattern": "{@date}_{@type}_{map_source}_{area_name}"},
  "utility_bill_hu": {"token": "UTILITY"},
  "receipt": {"token": "RECEIPT"},
  "bank_statement": {"token": "STATEMENT"},
  "contract": {"token": "CONTRACT"},
  "ticket": {"token": "TICKET"},
  "tax_return": {"token": "TAX-RETURN"},
  "performance_certificate": {"token": "COMPLETION-CERTIFICATE"},
  "payment_reminder": {"token": "PAYMENT-REMINDER"},
  "other": {"token": "OTHER"},
  "unknown": {"token": "UNKNOWN"}
 },
 "reason_scope": {
  "detect": "@type",
  "detect_detail": "@type",
  "no_invoice": "@type",
  "validator:dates": "kind:date",
  "parties": "kind:name",
  "validator:parties": "kind:name",
  "jev:parties_swapped": "kind:name",
  "llm:failed": "*",
  "llm:truncated": "*",
  "jev_unavailable": "*",
  "signal:prompt_injection": "*",
  "ocr:escalation_blocked": "*"
 },
 "reason_labels": {
  "missing": "missing: {field}",
  "todo": "open to-do: {field}",
  "todo_all": "an open to-do on the whole document",
  "type": "the type is unknown or uncertain",
  "not_done": "the item's processing did not finish",
  "source_changed": "the source file changed or is missing; it cannot be copied"
 },
 "manifest_columns": {
  "path": "New file",
  "status": "Status",
  "why": "Why to check",
  "original": "Original file name",
  "source_path": "Original path",
  "sha256": "Fingerprint (SHA-256)",
  "doc_type": "Type",
  "item_id": "Item ID"
 },
 "status_labels": {
  "ready": "ready",
  "review": "to check (file name)",
  "skipped": "skipped"
 }
}
