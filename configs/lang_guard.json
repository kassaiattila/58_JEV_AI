{
  "meta": {
    "name": "lang_guard",
    "version": "1.0.19",
    "description": "Language guard (073, plan N-angol, jav/lang_guard.py): a ratchet on the number of lines with Hungarian letters per tracked file. A file may not exceed its baseline entry; a file without an entry may not contain any. The baseline only shrinks (lang-guard --update); raising an entry needs lang-guard --accept <path> (document vocabulary, test data). allow: patterns that are never counted (UI translation files).",
    "changelog": [
      {
        "version": "1.0.19",
        "date": "2026-10-10",
        "note": "136: accept the document vocabulary of the tabular statement profiles (the column headers, account labels and total row of the Hungarian Revolut export, configs/statement_tables.json) and the synthetic Hungarian export the reader's tests build (tests/test_statement_table_136.py). All other file limits are unchanged."
      },
      {
        "version": "1.0.18",
        "date": "2026-10-10",
        "note": "135: accept the Hungarian names of the pairing page's filter controls in the user guide (docs/guides/USER_GUIDE.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.17",
        "date": "2026-10-10",
        "note": "135: accept the Hungarian column of the partner, earlier reason and invoice expected glossary entries (docs/GLOSSARY.md) and the Hungarian names of two new pairing page controls in the user guide (docs/guides/USER_GUIDE.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.16",
        "date": "2026-10-10",
        "note": "134: accept the Hungarian column of the two new glossary entries of the AI pre-matching (the AI proposal and the kind of payment, docs/GLOSSARY.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.15",
        "date": "2026-10-10",
        "note": "134: accept the Hungarian column of the three new glossary entries of the pre-matching (the reference number, the loose name match and a candidate's strength, docs/GLOSSARY.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.14",
        "date": "2026-10-10",
        "note": "133: accept the Hungarian interface labels quoted in italics in the user guide's new section on the own parties (Settings, docs/guides/USER_GUIDE.md section 10.3) and in the reconciliation package's section on choosing the party and the other parties' invoices (sections 4 and 5.3), as in the rest of the guide. All other file limits are unchanged."
      },
      {
        "version": "1.0.13",
        "date": "2026-10-10",
        "note": "133: accept the Hungarian column of the three new glossary entries of the own parties (the own party, the name variant and the dismissed identity, docs/GLOSSARY.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.12",
        "date": "2026-10-10",
        "note": "132 E2: accept the Hungarian interface labels quoted in italics in the user guide's new section on the reconciliation package (the stages, filters, buttons and reasons a person sees, docs/guides/USER_GUIDE.md section 5.3), as in the rest of the guide, and the Hungarian column of the two new glossary entries (the pairing and the selection bar, docs/GLOSSARY.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.11",
        "date": "2026-10-09",
        "note": "131 E1: accept the Hungarian column of the three new glossary entries of the reconciliation package (the package, the allocation and the needs-no-invoice mark, docs/GLOSSARY.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.10",
        "date": "2026-10-09",
        "note": "131: accept the reconciliation's new golden cases (the payment method and the purchase line of an invented cheque bill and card statement as document vocabulary, configs/golden_reconcile.json) and the Hungarian column of the three new glossary entries (the payment method, the same amount alone and the learnt name, docs/GLOSSARY.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.9",
        "date": "2026-10-09",
        "note": "130: accept the Hungarian column of the three new glossary entries of the card payments in another currency (the MNB exchange rate, the converted amount and the card payment band, docs/GLOSSARY.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.8",
        "date": "2026-10-08",
        "note": "129: accept document vocabulary of the party-name tail rule - the Hungarian words for a partner and a branch and the Polish word for a partnership in the candidate finder's name-continuation pattern (jav/candidates.py), and the invented Hungarian and Polish company names of its test (tests/test_name_tail_129.py). All other file limits are unchanged."
      },
      {
        "version": "1.0.7",
        "date": "2026-10-08",
        "note": "129: accept the Hungarian column of the new glossary entry for a person's reconciliation decision (docs/GLOSSARY.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.6",
        "date": "2026-10-08",
        "note": "128: accept the reconciliation's golden cases (a Hungarian bank fee line and memo word as document vocabulary, configs/golden_reconcile.json) and the four new glossary entries' Hungarian column (docs/GLOSSARY.md). All other file limits are unchanged."
      },
      {
        "version": "1.0.5",
        "date": "2026-10-08",
        "note": "127: accept the new round-B data files, which the check saw only once they were committed: the invented golden documents (configs/golden_synthetic.json) and the synthetic test lines of three tests; and the legal-form adjectives of the candidate finder (jav/candidates.py). All other file limits are unchanged."
      },
      {
        "version": "1.0.4",
        "date": "2026-10-08",
        "note": "127: accept document vocabulary in the round-B changes - the credit-note, buyer and street words of the candidate patterns (jav/candidates.py), the credit-note glossary line of the Hungarian selection questions (select.json), the pro forma and invoice titles of the type registry (doc_types.json) - and the Hungarian words of three new glossary entries; the data guard config lost six Hungarian lines. All other file limits are unchanged."
      },
      {
        "version": "1.0.3",
        "date": "2026-10-07",
        "note": "126: accept the Hungarian word of the new glossary entry (modified version) and the Hungarian interface labels quoted in the user guide's duplicate-invoice text; English definitions and all other file limits are unchanged (the utility report view shrank by one)."
      },
      {
        "version": "1.0.2",
        "date": "2026-10-07",
        "note": "124: accept the Hungarian word of the new glossary entry for the taken-over Azure recognition; English definitions and all other file limits are unchanged."
      },
      {
        "version": "1.0.1",
        "date": "2026-10-03",
        "note": "Accept the six Hungarian translations added to the bilingual glossary for planned ingestion terms; English definitions and all other file limits are unchanged."
      },
      {
        "version": "1.0.0",
        "date": "2026-09-30",
        "note": "073: first version; baseline taken after the documentation step (A) of the English conversion."
      }
    ]
  },
  "allow": [
    "ui/src/i18n/*.json"
  ],
