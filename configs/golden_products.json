  "inv_general_conditions": {
   "content": {
    "kind": "general",
    "title": "Vállalkozói vagyonbiztosítás általános feltételei (KB-ÁF-2026)",
    "valid_from": "2026-01-01",
    "sections": [
     {
      "clause": "1",
      "page": 1,
      "title": "A biztosítás területi hatálya"
     },
     {
      "clause": "2",
      "page": 1,
      "title": "Nem biztosítható tevékenységek"
     },
     {
      "clause": "3.1",
      "page": 2,
      "title": "Kárelőzmény"
     },
     {
      "clause": "3.2",
