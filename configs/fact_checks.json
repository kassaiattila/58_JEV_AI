   "date": {
    "value_label": "Date",
    "meaning_label": "date",
    "value_patterns": [
     "\\b\\d{4}\\s*[.\\-/]\\s*\\d{1,2}\\s*[.\\-/]\\s*\\d{1,2}\\b",
     "\\b\\d{1,2}\\s*[.\\-/]\\s*\\d{1,2}\\s*[.\\-/]\\s*\\d{4}\\b",
     "(?i)\\b\\d{4}\\.?\\s+(?:janu\u00e1r|febru\u00e1r|m\u00e1rcius|\u00e1prilis|m\u00e1jus|j\u00fanius|j\u00falius|augusztus|szeptember|okt\u00f3ber|november|december)\\b",
     "(?i)\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{1,2},?\\s+\\d{4}\\b",
     "(?i)\\b\\d{1,2}\\s+(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{4}\\b"
    ],
    "words": [
     "kelt",
