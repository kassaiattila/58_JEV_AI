{
 "meta": {
  "name": "fact_checks",
  "version": "1.0.0",
  "description": "Deterministic content checks shared by the extraction paths (jav/fact_checks.py). They never change a value or a model answer; they only name a reason for human review. Hungarian entries are document vocabulary.",
  "changelog": [
   {
    "version": "1.0.0",
    "date": "2026-10-06",
    "note": "120: unfilled template placeholders; quantity-kind conflicts (money, percentage, date, time) generalising the 119 money/time warning; one party in two roles (name subset or tax-number stem)."
   }
  ]
 },
 "placeholders": {
  "reason": "Value looks like an unfilled template placeholder, not a stated fact",
  "patterns": [
   "\\[[^\\[\\]\\d]*[^\\W\\d_]{2}[^\\[\\]\\d]*\\]",
   "<[^<>\\d@/:]*[^\\W\\d_]{2}[^<>\\d@/:]*>",
   "\\{\\{?[^{}\\d]*[^\\W\\d_]{2}[^{}\\d]*\\}\\}?",
   "(?:[._]{4,}|\u2026{2,})",
   "(?i)\\b(?:\u00e9\u00e9\u00e9\u00e9|yyyy|jjjj|aaaa)\\s*[.\\-/]\\s*(?:hh|mm)\\s*[.\\-/]\\s*(?:nn|dd|tt|jj)\\b",
   "(?i)\\b(?:nn|dd|tt|jj)\\s*[.\\-/]\\s*(?:hh|mm)\\s*[.\\-/]\\s*(?:\u00e9\u00e9\u00e9\u00e9|yyyy|jjjj|aaaa)\\b"
  ]
 },
 "quantities": {
  "reason": "{value} value conflicts with a {meaning} quantity; check the property and unit",
  "kinds": {
   "money": {
    "value_label": "Currency",
    "meaning_label": "money",
    "value_patterns": [
     "(?i)(?:\\b(?:HUF|Ft|EUR|USD|GBP|CHF|forint|euro|dollars?)\\b|[\u20ac$\u00a3])"
