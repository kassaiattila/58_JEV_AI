{
  "meta": {
    "name": "process:insurance_renewal",
    "version": "1.0.0",
    "description": "231 (stage D, D-g; the owner's decision of 2026-10-26: the second small composition): the renewal of an existing client's business property insurance, composed from the very capabilities the insurance quote uses, in another structure and with no code of its own. An existing client is not asked from the company register, only from the sanctions list; there is no wait for missing facts: the risk is accepted only when the rules allow it, and a risk they refer, refuse or cannot decide (facts missing) goes to the full quote (the case closes as referred); the premium is decided by another person than the risk's above a lower limit; the offer is printed, its covering letter written from the renewal's own frame, and a person sends it into the output folder. The product, the tariff, the register and the limit are invented.",
    "changelog": [
      {"version": "1.0.0", "date": "2026-10-27", "note": "231 (D-g): the first version: the renewal, from the documents to the sent letter, of the insurance quote's capabilities only."}
    ]
  },
  "id": "insurance_renewal",
  "title": "Insurance renewal",
  "scope": {"parts": ["source"]},
  "intake": [{"on": "manual", "starts": "manual"}],
  "resources": {"product": "inv_business_property", "tariff": "inv_business_property_tariff"},
  "needs_at_start": ["product", "tariff"],
  "steps": [
    {"id": "documents", "uses": "process_documents@1", "title": "Documents", "params": {}},
    {"id": "facts", "uses": "fact_claims@1", "title": "Facts from the documents", "after": ["documents"],
     "params": {"from_step": "documents", "readings": "fact_readings_property"}},
    {"id": "sanctions", "uses": "lookup@1", "title": "Sanctions list", "after": ["facts"],
     "params": {"connector": "invented_sanctions_list", "from_step": "facts", "asks": {"name": "company_name"},
                "asks_if_known": {"tax_number": "tax_number"}, "answers": {"listed": "sanctions_listed"}}},
    {"id": "check", "uses": "field_check@1", "title": "Data check", "after": ["facts", "sanctions"],
     "params": {"catalogue": "property", "product": "@product"}},
    {"id": "evaluate", "uses": "rule_evaluation@1", "title": "Rules", "after": ["check"], "params": {"from_step": "check"}},
    {"id": "risk", "uses": "decision@1", "title": "Renewal decision", "after": ["evaluate"],
     "params": {"about": "evaluate",
                "choices": {"renew": {"title": "Renew", "allowed_when": {"verdict": ["allow"]}},
                            "full_quote": {"title": "Send to the full quote", "closes": "referred"}}}},
    {"id": "rate", "uses": "rating@1", "title": "Premium", "after": ["risk"],
     "params": {"from_step": "evaluate", "tariff": "@tariff"}},
    {"id": "premium", "uses": "decision@1", "title": "Premium decision", "after": ["rate"],
     "params": {"about": "rate",
                "choices": {"accept": {"title": "Accept the premium"},
                            "decline": {"title": "Decline the renewal", "closes": "declined"}},
                "other_than": "risk", "limit": "inv_renewal_second_person"}},
    {"id": "document", "uses": "priced_document@1", "title": "Offer document", "after": ["premium"],
     "params": {"output": "rated_offer", "from_step": "premium"}},
    {"id": "letter", "uses": "letter@1", "title": "Covering letter", "after": ["document"],
     "params": {"frame": "renewal_letter", "from_step": "document"}},
    {"id": "send", "uses": "send@1", "title": "Send", "after": ["letter"], "start": "person",
     "params": {"message": "letter", "mode": "output_folder", "from_step": "letter"}}
  ],
  "screens": {
    "tabs": [
      {"id": "overview", "label": "Overview", "elements": [{"type": "blockers"}, {"type": "package_work", "step": "documents"},
        {"type": "cost"}]},
      {"id": "data", "label": "Data check", "elements": [{"type": "field_review", "step": "check"},
        {"type": "document_facts", "step": "facts"}, {"type": "lookup", "step": "sanctions"}]},
      {"id": "calculation", "label": "Calculation and versions", "elements": [{"type": "evaluation", "step": "evaluate"},
        {"type": "calculation", "step": "rate"}]},
      {"id": "decision", "label": "Decision and release",
       "elements": [{"type": "decision", "step": "risk"}, {"type": "decision", "step": "premium"},
                    {"type": "document_view", "step": "document"}, {"type": "letter", "step": "letter"},
                    {"type": "handover_view", "step": "send"}]},
      {"id": "history", "label": "History", "elements": [{"type": "timeline"}]}
    ]
  },
  "outputs": ["rated_offer"],
  "goldens": []
}
