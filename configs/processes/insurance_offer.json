{
  "meta": {
    "name": "process:insurance_offer",
    "version": "1.2.0",
    "description": "231 (stage D, D-f3; the owner's decisions of 2026-10-26): a business property insurance quote as a process pack of shared capabilities only. A case processes the documents of its source (the quote request form, a property schedule per site, the claims history), turns what they hold into facts of the assessed units, asks the company register and the sanctions list, and a person checks and freezes the facts; the rules of the product version the case kept are evaluated, missing facts are asked for by a deadline, a person decides on the risk, the premium is computed from the tariff the case kept, and a person decides on the premium (above the limit another person than the risk's). The product, its rules, its tariff, the registers and the limit are invented (the trial); a live product and a live limit are the owner's decisions.",
    "changelog": [
      {"version": "1.2.0", "date": "2026-10-26", "note": "231 (D-f5): the Calculation and versions view: the rules' evaluation, the missing facts and the premium, each with its versions; the cost moves to the Overview."},
      {"version": "1.1.0", "date": "2026-10-26", "note": "231 (D-f4): the Data check view: the field review of the check (the units, the disagreements to settle, the freeze), the facts read from the documents, and the two registers' answers."},
      {"version": "1.0.0", "date": "2026-10-26", "note": "231 (D-f3): the first version: from the documents to the premium decision; its work views come with stage D-f's elements."}
    ]
  },
  "id": "insurance_offer",
  "title": "Insurance quote",
  "scope": {"parts": ["source"]},
  "intake": [{"on": "manual", "starts": "manual"}],
  "resources": {"product": "inv_business_property", "tariff": "inv_business_property_tariff"},
  "needs_at_start": ["product", "tariff"],
  "steps": [
    {"id": "documents", "uses": "process_documents@1", "title": "Documents", "params": {}},
    {"id": "facts", "uses": "fact_claims@1", "title": "Facts from the documents", "after": ["documents"],
     "params": {"from_step": "documents", "readings": "fact_readings_property"}},
    {"id": "company", "uses": "lookup@1", "title": "Company register", "after": ["facts"],
     "params": {"connector": "invented_company_register", "from_step": "facts", "asks": {"tax_number": "tax_number"},
                "answers": {"company.status": "company_status", "company.activity_code": "activity_code"}}},
    {"id": "sanctions", "uses": "lookup@1", "title": "Sanctions list", "after": ["facts"],
     "params": {"connector": "invented_sanctions_list", "from_step": "facts", "asks": {"name": "company_name"},
                "asks_if_known": {"tax_number": "tax_number"}, "answers": {"listed": "sanctions_listed"}}},
    {"id": "check", "uses": "field_check@1", "title": "Data check", "after": ["facts", "company", "sanctions"],
     "params": {"catalogue": "property", "product": "@product"}},
    {"id": "evaluate", "uses": "rule_evaluation@1", "title": "Rules", "after": ["check"], "params": {"from_step": "check"}},
    {"id": "missing", "uses": "missing_info@1", "title": "Missing facts", "after": ["evaluate"],
     "params": {"from_step": "evaluate", "days": 14, "closes": "expired"}},
    {"id": "risk", "uses": "decision@1", "title": "Risk decision", "after": ["missing"],
     "params": {"about": "evaluate",
                "choices": {"accept": {"title": "Accept the risk", "allowed_when": {"verdict": ["allow", "refer"]}},
                            "decline": {"title": "Decline the risk", "closes": "declined"}}}},
    {"id": "rate", "uses": "rating@1", "title": "Premium", "after": ["risk"],
     "params": {"from_step": "evaluate", "tariff": "@tariff"}},
    {"id": "premium", "uses": "decision@1", "title": "Premium decision", "after": ["rate"],
     "params": {"about": "rate",
                "choices": {"accept": {"title": "Accept the premium"},
                            "decline": {"title": "Decline the quote", "closes": "declined"}},
                "other_than": "risk", "limit": "inv_premium_second_person"}}
  ],
  "screens": {
    "tabs": [
      {"id": "overview", "label": "Overview", "elements": [{"type": "package_work", "step": "documents"}, {"type": "cost"}]},
      {"id": "data", "label": "Data check", "elements": [{"type": "field_review", "step": "check"},
        {"type": "document_facts", "step": "facts"}, {"type": "lookup", "step": "company"}, {"type": "lookup", "step": "sanctions"}]},
      {"id": "calculation", "label": "Calculation and versions", "elements": [{"type": "evaluation", "step": "evaluate"},
        {"type": "missing_info", "step": "missing"}, {"type": "calculation", "step": "rate"}]},
      {"id": "decision", "label": "Decision and release",
       "elements": [{"type": "approval", "step": "risk"}, {"type": "approval", "step": "premium"}]},
      {"id": "history", "label": "History", "elements": [{"type": "timeline"}]}
    ]
  },
  "outputs": [],
  "goldens": []
}
