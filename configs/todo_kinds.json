    {"code": "pick:absent_but_chosen", "shape": "pick:absent_but_chosen:<field>:<p>", "owners": ["jav/policy.py"], "what": "the field is probably not on the document, yet a value was picked", "example": "pick:absent_but_chosen:due_date:0.71"},
    {"code": "pick:present_but_none", "shape": "pick:present_but_none:<field>:<p>", "owners": ["jav/policy.py"], "what": "the field is on the document, but no candidate was picked", "example": "pick:present_but_none:supplier_tax_id:0.84"},
    {"code": "pick:no_candidates", "shape": "pick:no_candidates:<field>", "owners": ["jav/policy.py"], "what": "the code found no candidate for the field", "example": "pick:no_candidates:invoice_number"},
    {"code": "pick:present_no_candidates", "shape": "pick:present_no_candidates:<field>:<p>", "owners": ["jav/policy.py"], "what": "the field is on the document, but the code found no candidate", "example": "pick:present_no_candidates:buyer_tax_id:0.77"},
