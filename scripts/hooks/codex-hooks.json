{
  "description": "Project handoff lifecycle hooks; install as .codex/hooks.json and review in Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/handoff_guard.py\" session-start",
            "commandWindows": "$projectRoot = git rev-parse --show-toplevel; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & (Join-Path $projectRoot '.venv/Scripts/python.exe') (Join-Path $projectRoot 'scripts/hooks/handoff_guard.py') session-start",
            "timeout": 30,
            "additionalContextLimit": 1800,
            "statusMessage": "Loading the latest project handoff"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/handoff_guard.py\" pre-compact",
            "commandWindows": "$projectRoot = git rev-parse --show-toplevel; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & (Join-Path $projectRoot '.venv/Scripts/python.exe') (Join-Path $projectRoot 'scripts/hooks/handoff_guard.py') pre-compact",
            "timeout": 30,
            "statusMessage": "Checking handoff freshness before compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/handoff_guard.py\" stop",
            "commandWindows": "$projectRoot = git rev-parse --show-toplevel; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & (Join-Path $projectRoot '.venv/Scripts/python.exe') (Join-Path $projectRoot 'scripts/hooks/handoff_guard.py') stop",
            "timeout": 30,
            "statusMessage": "Checking project state at session close"
          }
        ]
      }
    ]
  }
}
