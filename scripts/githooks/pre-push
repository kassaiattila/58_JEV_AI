#!/bin/sh
# Data guard before a push:
#   1. only `main`, the release tags and one stage branch go (`push` in configs/data_guard.json), and a branch or tag
#      built on a history listed under `forbidden_history` there, or not on the repository's current root
#      commit (`push.root`), is refused;
#   2. the new lines of the commits not yet pushed pass the same data guard as before a commit.
# Description: docs/guides/DEVELOPMENT.md §1.
root=$(git rev-parse --show-toplevel) || exit 1
py="$root/.venv/Scripts/python.exe"
[ -x "$py" ] || py="$root/.venv/bin/python"
[ -x "$py" ] || py=python
cd "$root" && exec "$py" -X utf8 -m jav.devtools.data_guard pre-push "$@"
