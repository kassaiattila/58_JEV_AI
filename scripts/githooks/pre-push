#!/bin/sh
# Data guard before a push:
#   1. a branch or tag built on a history listed under `forbidden_history` in configs/data_guard.json is refused;
#   2. the new lines of the commits not yet pushed pass the same data guard as before a commit.
# Description: docs/guides/DEVELOPMENT.md §1.
root=$(git rev-parse --show-toplevel) || exit 1
py="$root/.venv/Scripts/python.exe"
[ -x "$py" ] || py="$root/.venv/bin/python"
[ -x "$py" ] || py=python
cd "$root" && exec "$py" -X utf8 -m jav.data_guard pre-push "$@"
