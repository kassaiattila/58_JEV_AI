#!/bin/sh
# 071 data guard (plan 070 2.1): the new lines of a commit may hold no personal data, key, internal working document
# or document. The check is jav/devtools/data_guard.py, its exceptions configs/data_guard.json.
# Installation: python -m jav.cli hooks-install (core.hooksPath). Description: docs/guides/DEVELOPMENT.md 1.
root=$(git rev-parse --show-toplevel) || exit 1
py="$root/.venv/Scripts/python.exe"
[ -x "$py" ] || py="$root/.venv/bin/python"
[ -x "$py" ] || py=python
cd "$root" && exec "$py" -X utf8 -m jav.devtools.data_guard pre-commit
